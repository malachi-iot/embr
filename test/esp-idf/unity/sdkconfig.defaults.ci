CONFIG_EMBR_QEMU_MODE=y
# Must be listed AFTER sdkconfig.defaults(.esp32s3) in SDKCONFIG_DEFAULTS so this wins.
# QEMU ESP32-S3: SPIRAM shares MMU vaddr with flash mmap; SPIRAM=y breaks nvs_flash_init
# (esp_mmu_map: no such vaddr range). Hardware keeps SPIRAM via sdkconfig.defaults.esp32s3.
# Evidence / same workaround:
#   https://github.com/GlomarGadaffi/tdeck-max-phone/issues/15
#   https://github.com/espressif/esp-idf/issues/8747  (32MB external VA shared flash+PSRAM)
CONFIG_SPIRAM=n
