menu "dsp"

    config EMBR_DSP_PRECALC_TABLE
        bool "sin/cos precalc"
        default y
        help
            Indicates whether to pre allocate static space for prealloc
            tables.  Note that linker removes this if not actually used, so is
            largely harmless to leave enabled.

    config EMBR_DSP_PRECALC_TABLE_SZ
        int "sin/cos precalc table size"
        default 4096
        depends on EMBR_DSP_PRECALC_TABLE

endmenu
