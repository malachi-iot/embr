menu "Garbage Collection"

    # DORMANT

    config EMBR_GLOBAL_GC_STORAGE_SZ
        int "Global garbage collector static size (in bytes, 4-byte boundary)"
        default 0
        help
            0 = disabled

    config EMBR_GLOBAL_GC_HANDLE_SZ
        int "Global garbage collector handle count"
        depends on EMBR_GLOBAL_GC_STORAGE_SZ > 0
        default 64 if EMBR_GLOBAL_GC_STORAGE_SZ > 4096
        default 32

endmenu